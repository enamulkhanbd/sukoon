# Optional: Remote Hijri moon-sighting calendar JSON URL (updates instantly without redeploying the app).
# Leave empty to use the bundled /hijri-calendar.json from public/hijri-calendar.json.
#
# GitHub Gist example (omit the commit hash after /raw/ so edits always serve the latest version):
# VITE_HIJRI_CALENDAR_URL=https://gist.githubusercontent.com/<your-username>/<gist-id>/raw/hijri-calendar.json
VITE_HIJRI_CALENDAR_URL=
